// Compiles the LOK server to plain JavaScript in `dist-lok-server/`.
//
// Same reasoning as tsconfig.mcp.json: a dev runner's banner on stdout would
// sit in the same process tree as the host's own stdout/stdin pipe handling,
// and a compiled, silent `node dist-lok-server/...` start is one less thing
// to debug when the two are talking to each other.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-lok-server",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "ws"],
    "lib": ["ES2022"]
  },
  "include": ["lok/server/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
