{
  "name": "songs-teacher",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Native music presentation editor with audio-synced slides.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ug.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "ug:server": "node --import tsx server/ug/server.ts",
    "ug:install-browser": "node --import tsx server/ug/install-browser.ts",
    "dev:agent": "node --import tsx server/ug/dev.ts"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "demucs-web": "^1.0.2",
    "dotenv": "^18.0.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.2.1",
    "onnxruntime-web": "^1.27.0",
    "openai": "^7.19.0",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tonal": "^6.4.3",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
