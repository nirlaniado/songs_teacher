    "react-dom": "^19.2.8",
    "tonal": "^6.4.3",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
