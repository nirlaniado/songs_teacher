# Copy this file to `.env` and fill in your key:
#
#   cp .env.example .env
#
# `.env` is gitignored. This template is not — keep secrets out of it.
#
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY: Vite inlines every VITE_* variable into the JavaScript bundle at
# build time. The key below WILL be readable by anyone who opens devtools or
# downloads the built files. That is fine for running this locally on your own
# machine, which is what libre-off is built for.
#
# Do NOT deploy a build made with this key to a public URL — anyone visiting
# could read it and spend your credits. If you ever host this app, delete the
# key from `.env`, rebuild, and let each user enter their own through the
# assistant's ⚙ settings instead (that one stays in their browser only).
# ─────────────────────────────────────────────────────────────────────────────

# Your key from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-proj-replace-me

# Optional. Any OpenAI-compatible endpoint works — point this at Ollama
# (http://localhost:11434/v1) or Groq (https://api.groq.com/openai/v1) to avoid
# per-token charges entirely.
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Needs to support JSON-schema structured output.
VITE_OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# Genius — song METADATA for title slides (artist, album, year, cover art).
# Used only by the MCP server (`npm run mcp:build`), not by the web app.
#
# Get one free: https://genius.com/api-clients → "New API Client" → fill in any
# name/URL → then copy the "CLIENT ACCESS TOKEN" (not the Client ID or Secret).
#
# Deliberately NOT `VITE_`-prefixed: Node reads it directly, so unlike the
# OpenAI key above it is never inlined into the browser bundle.
#
# Genius exposes no lyrics endpoint. This fetches metadata only.
# ─────────────────────────────────────────────────────────────────────────────
# Used by BOTH the MCP server and the in-app assistant. The web app reaches
# Genius through a dev-server proxy (see vite.config.ts), so this stays
# server-side and never enters the browser bundle.
GENIUS_ACCESS_TOKEN=replace-me

# ─────────────────────────────────────────────────────────────────────────────
# Stem separation (optional). Overrides where the ~172MB Demucs ONNX model is
# fetched from — self-host it, or point at a different export. The default is
# a public Hugging Face copy, cached in the browser after the first download.
# ─────────────────────────────────────────────────────────────────────────────
# VITE_DEMUCS_MODEL_URL=https://example.com/htdemucs_embedded.onnx
