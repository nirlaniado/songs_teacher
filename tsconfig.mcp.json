{
  // Compiles the MCP server to plain JavaScript in `dist-mcp/`.
  //
  // Deliberately compiled rather than run through vite-node or tsx: an MCP
  // stdio server speaks JSON-RPC over stdout, so any banner a dev runner
  // prints there corrupts the protocol. `node dist-mcp/server.js` emits
  // nothing it wasn't told to.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-mcp",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    // The server only imports schema, agent and template modules — all pure
    // TypeScript with no JSX and no browser globals.
    "lib": ["ES2022"]
  },
  "include": ["mcp/**/*.ts", "src/schema/**/*.ts", "src/agent/**/*.ts", "src/deck/**/*.ts", "src/adapters/types.ts"],
  // Providers are browser-side: they read `import.meta.env` and call `fetch`
  // against a configured endpoint. The server needs none of them — it *is*
  // the producer of ops here, driven by whichever model the MCP client runs.
  "exclude": ["**/*.test.ts", "src/agent/providers/**"]
}
